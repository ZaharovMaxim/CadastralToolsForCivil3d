<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:tns="http://rosleshoz.gov.ru/fgis-lk/common/enums/basisForChange/types/2.0" elementFormDefault="qualified" targetNamespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/basisForChange/types/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="BasisForChangeKindEType">
        <xs:annotation>
            <xs:documentation>Основание для внесения изменений в Лесную декларацию</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="48200001">
                <xs:annotation>
                    <xs:documentation>Изменение условий договора аренды или иного документа, в соответствии с которым осуществляется использование лесов</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="48200002">
                <xs:annotation>
                    <xs:documentation>Внесение изменений в проект освоения лесов</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="48200003">
                <xs:annotation>
                    <xs:documentation>Продление сроков рубки лесных насаждений, хранения и вывоза древесины согласно Правилам заготовки древесины</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="48200004">
                <xs:annotation>
                    <xs:documentation>Исключение отдельных лесосек, объектов лесной инфраструктуры, объектов лесоперерабатывающей инфраструктуры и объектов, не связанных с созданием лесной инфраструктуры</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="48200005">
                <xs:annotation>
                    <xs:documentation>Замена отдельных лесосек, объектов лесной инфраструктуры, объектов лесоперерабатывающей инфраструктуры и объектов, не связанных с созданием лесной инфраструктуры на другие до начала рубки лесных насаждений</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="48200006">
                <xs:annotation>
                    <xs:documentation>Внесение изменений в материалы отвода и таксации лесосек при обнаружении ошибок до начала рубки лесных насаждений</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
