                </xs:annotation>
            </xs:element>
            <xs:element name="rootConiferVolume" type="st:PositiveDecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Корневой запас хвойных насаждений</xs:documentation>
                </xs:annotation>
            </xs:element>
