    <xs:complexType name="volumeResourceRow">
        <xs:annotation>
            <xs:documentation>Строка объема заготовки лесных ресурсов</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:choice>
                <xs:element name="resource" type="fRes:ForestResoursKindEType">
                    <xs:annotation>
                        <xs:documentation>Вид ресурса (ягоды, грибы)</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="agricultureType" type="agrT:TypesAgricultureKindEType">
                    <xs:annotation>
                        <xs:documentation>Вид сельского хозяйства (пчеловодство, выращивание сельскохозяйственных
                            культур и т.п.)
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
            <xs:element name="typeResource" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Детальное описание вида ресурса (Виды грибов, ягод, орехов и т.п.)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="area" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь, га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unitType" type="comR:UnitTypeType">
                <xs:annotation>
                    <xs:documentation>Единица измерения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="fund" type="st:PositiveDecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Фонд всего (ежегодный допустимый объем/норматив)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="fundAnnual" type="st:PositiveDecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Проектируемые ежегодные объемы заготовки</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
