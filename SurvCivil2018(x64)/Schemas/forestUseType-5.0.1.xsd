        <xs:annotation>
            <xs:documentation>Проектируемый объем и местоположение рубок лесных насаждений на лесном участке при использовании лесов не связанных с заготовкой древесины</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="object" type="tns:ObjectInfoType">
                <xs:annotation>
                    <xs:documentation>Проектируемый объект</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="location" type="comR:Location2Type">
                <xs:annotation>
                    <xs:documentation />
                </xs:annotation>
            </xs:element>
            <xs:element name="area" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь объекта, строения, сооружения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="rootVolume" type="st:PositiveDecimalTwoSType">
