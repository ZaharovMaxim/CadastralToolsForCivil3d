    <xs:complexType name="volumeResource">
        <xs:annotation>
            <xs:documentation>объема заготовки лесных ресурсов</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="content" type="cType:contentType" />
