    <xs:complexType name="volumeResourceResin">
        <xs:annotation>
            <xs:documentation>Тип описания раздела</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="content" type="cType:contentType" />
            <xs:element name="table">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:volumeResourceResinRow" minOccurs="0" maxOccurs="1" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="volumeResourceResinRow">
        <xs:sequence>
            <xs:element name="useful" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>1. Всего спелых и перестойных насаждений, пригодных для подсочки</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="completion" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>1.1. Из них не вовлечены в подсочку:</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unprofitable" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>в том числе нерентабельные</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="maybe" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>2. Может ежегодно находиться в подсочке</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="used" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>3. Фактически находится в подсочке</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="finished" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>4. Вышедшие из подсочки, всего</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
