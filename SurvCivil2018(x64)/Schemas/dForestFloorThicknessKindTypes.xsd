<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:tns="http://rosleshoz.gov.ru/fgis-lk/common/enums/forestFloorThickness/types/2.0" elementFormDefault="qualified" targetNamespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/forestFloorThickness/types/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:simpleType name="ForestFloorThicknessKindEType">
		<xs:annotation>
			<xs:documentation>Толщина лесной подстилки</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="fivePointOneTenthToSixCm">
				<xs:annotation>
					<xs:documentation>5,1 - 6 см</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="fourPointOneTenthToFiveCm">
				<xs:annotation>
					<xs:documentation>4,1 - 5 см</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="noForestFloor">
				<xs:annotation>
					<xs:documentation>Лесной подстилки нет</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="onePointOneTenthToTwoCm">
				<xs:annotation>
					<xs:documentation>1,1 - 2 см</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="overSixCm">
				<xs:annotation>
					<xs:documentation>&gt; 6 см</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="threePointOneTenthToFourCm">
				<xs:annotation>
					<xs:documentation>3,1 - 4 см</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="twoPointOneTenthToThreeCm">
				<xs:annotation>
					<xs:documentation>2,1 - 3 см</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="zeroToOneCm">
				<xs:annotation>
					<xs:documentation>0 - 1 см</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
