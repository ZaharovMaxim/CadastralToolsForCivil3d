<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified"
    targetNamespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/treeHeightRange/types/1.0"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="dTreeHeightRange" xmlns:xs="http://www.w3.org/2001/XMLSchema">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Lower1m">
                <xs:annotation>
                    <xs:documentation>До 1 м</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Lower2m">
                <xs:annotation>
                    <xs:documentation>1,1 - 2 м</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Lower3m">
                <xs:annotation>
                    <xs:documentation>2,1 -3 м</xs:documentation>
