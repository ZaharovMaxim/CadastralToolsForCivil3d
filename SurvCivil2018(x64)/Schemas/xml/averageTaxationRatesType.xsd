<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           targetNamespace="http://rosleshoz.gov.ru/xmlns/averageTaxationRatesType/5.0"
           xmlns:tns="http://rosleshoz.gov.ru/xmlns/averageTaxationRatesType/5.0"
           xmlns:st="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.0"
           xmlns:comR="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1"
           xmlns:purF="http://rosleshoz.gov.ru/fgis-lk/common/enums/purposeForests/types/2.1"
           xmlns:bon="http://rosleshoz.gov.ru/fgis-lk/common/enums/bonitet/types/2.1"
           xmlns:complet="http://rosleshoz.gov.ru/fgis-lk/common/enums/completenesSlayer/types/2.1"
           xmlns:fa="http://rosleshoz.gov.ru/fgis-lk/common/enums/farms/types/2.1">

    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/purposeForests/types/2.1" schemaLocation="dPurposeForestsKindTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/farms/types/2.1" schemaLocation="dFarmsKindTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.0" schemaLocation="simpleTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1" schemaLocation="commonReport.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/bonitet/types/2.1" schemaLocation="dBonitetKindTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/completenesSlayer/types/2.1" schemaLocation="dCompletenesSlayerKindTypes.xsd"/>

    <xs:complexType name="averageTaxationRatesType">
        <xs:annotation>
            <xs:documentation>Средняя характеристика по лесному участку</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="resources" type="tns:resourcesType">
                <xs:annotation>
                    <xs:documentation>Всего по лесному участку</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="specialPurposeInfo">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:specialPurposeInfoRow" maxOccurs="3" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="farmInfo">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:farmInfoRow" maxOccurs="3" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="specialPurposeInfoRow">
        <xs:annotation>
            <xs:documentation>Средняя характеристика по целевому назначению лесов</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="specialPurpose" type="purF:PurposeForestsKindEType">
                <xs:annotation>
                    <xs:documentation>Целевое назначение лесов</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="resources" type="tns:resourcesType" />
            <xs:element name="farmInfo">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:farmInfoRow" maxOccurs="3" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="farmInfoRow">
        <xs:annotation>
            <xs:documentation>Средняя характеристика по хозяйству</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="farm" type="fa:FarmsKindEType">
                <xs:annotation>
                    <xs:documentation>Справочник "Хозяйства"</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="resources" type="tns:resourcesType" />
            <xs:element name="treeInfo">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:treeInfoRow" minOccurs="0" maxOccurs="unbounded" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="treeInfoRow">
        <xs:annotation>
            <xs:documentation>Средняя характеристика по преобладающим породам</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="tree" type="comR:TreeType">
                <xs:annotation>
                    <xs:documentation>Преобладающая порода</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="resources" type="tns:resourcesType" />
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="resourcesType">
        <xs:annotation>
            <xs:documentation>Детальная строка</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="area" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь, га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="age" type="xs:int">
                <xs:annotation>
                    <xs:documentation>Возраст насаждения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="bonitet" type="bon:BonitetKindEType">
                <xs:annotation>
                    <xs:documentation>Бонитет</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="completeness" type="complet:CompletenesSlayerKindEType">
                <xs:annotation>
                    <xs:documentation>Полнота насаждения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="volume" type="st:PositiveDecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Средний запас насаждений покрытых лесной растительностью на 1 га, м.куб</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ripeAndOverripe" type="st:PositiveDecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Средний запас спелых и перестойных насаждений на 1 га, м.куб</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="growth" type="st:PositiveDecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Средний прирост по запасу на 1 га, м.куб</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="composition" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Состав насаждения</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
