<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           targetNamespace="http://rosleshoz.gov.ru/xmlns/characteristicFireClassesType/5.0"
           xmlns:tns="http://rosleshoz.gov.ru/xmlns/characteristicFireClassesType/5.0"
           xmlns:st="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.0"
           xmlns:comR="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1">

    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.0" schemaLocation="simpleTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1" schemaLocation="commonReport.xsd"/>

    <xs:complexType name="characteristicFireClassesType">
        <xs:sequence>
            <xs:element name="locationInfo">
                <xs:annotation>
                    <xs:documentation>местоположение</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:locationInfoRow" minOccurs="0" maxOccurs="unbounded" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="amount" type="tns:amountType">
                <xs:annotation>
                    <xs:documentation>Всего</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="percent" type="tns:percentType">
                <xs:annotation>
                    <xs:documentation>%</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="locationInfoRow">
        <xs:sequence>
            <xs:element name="location" type="comR:Location2Type">
                <xs:annotation>
                    <xs:documentation />
                </xs:annotation>
            </xs:element>
            <xs:element name="amount" type="tns:amountType" />
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="amountType">
        <xs:sequence>
            <xs:element name="areaFireClasses_I" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь I класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_II" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь II класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_III" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь III класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_IV" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь IV класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_V" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь V класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="area" type="st:PositiveDecimalFourSType">
                <xs:annotation>
                    <xs:documentation>Площадь общая</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="middleClass" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Средний класс</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="percentType">
        <xs:sequence>
            <xs:element name="areaFireClasses_I" type="st:Positive100DecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Площадь I класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_II" type="st:Positive100DecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Площадь II класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_III" type="st:Positive100DecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Площадь III класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_IV" type="st:Positive100DecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Площадь IV класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="areaFireClasses_V" type="st:Positive100DecimalTwoSType">
                <xs:annotation>
                    <xs:documentation>Площадь V класса пожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="area" type="st:Positive100DecimalTwoSType"
                        default="100">
                <xs:annotation>
                    <xs:documentation>Площадь общая</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
