<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:tns="http://rosleshoz.gov.ru/fgis-lk/common/enums/timberDealKind/types/2.0" elementFormDefault="qualified" targetNamespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/timberDealKind/types/2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="TimberDealKindKindEType">
        <xs:annotation>
            <xs:documentation>Виды сделок с древесиной и продукцией ее переработки</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="common">
                <xs:annotation>
                    <xs:documentation>Сделка, оформляемая в ГЛР</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="foreign">
                <xs:annotation>
                    <xs:documentation>Внешнеторговая сделка</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="retailMarket">
                <xs:annotation>
                    <xs:documentation>Сделка по приобретению древесины на розничном рынке</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="retailTrade">
                <xs:annotation>
                    <xs:documentation>Сделка по приобретению древесины в организации розничной торговли</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="trade">
                <xs:annotation>
                    <xs:documentation>Сделка по реализации древесины на организованных торгах</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
