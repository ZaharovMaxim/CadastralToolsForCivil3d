<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:att="http://rosleshoz.gov.ru/fgis-lk/common/attachment/types/2.0"
           xmlns:doc="http://rosleshoz.gov.ru/fgis-lk/common/document/types/2.1"
           xmlns:idatt="http://rosleshoz.gov.ru/fgis-lk/common/enums/idatt/types/2.0"
           xmlns:tns="http://rosleshoz.gov.ru/fgis-lk/common/documentPackageTypes/types/2.1"
           targetNamespace="http://rosleshoz.gov.ru/fgis-lk/common/documentPackageTypes/types/2.1"
           elementFormDefault="qualified"
>

    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/attachment/types/2.0"
               schemaLocation="attachmentTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/idatt/types/2.0"
               schemaLocation="dAdditionalDocumentKindTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/document/types/2.1"
               schemaLocation="documentTypes.xsd"/>
    <xs:group name="DocumentAttachmentsGroup">
        <xs:annotation>
            <xs:documentation>Группа Вложений документа</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="contentId" type="att:AttachmentIdRefSType">
                <xs:annotation>
                    <xs:documentation>Идентификатор основного вложения (ссылка на элемент описи вложений)
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="attachmentId" maxOccurs="unbounded" minOccurs="0"
                        type="att:AttachmentIdRefSType">
                <xs:annotation>
                    <xs:documentation>Идентификатор дополнительного вложения (ссылка на элемент описи вложений)
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:group>
    <xs:complexType name="AdditionalDocumentType">
        <xs:annotation>
            <xs:documentation>Тип Приложение к прикладываемому документу</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="kind" type="idatt:AdditionalDocumentKindEType">
                <xs:annotation>
                    <xs:documentation>Вид приложения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="requisites" type="doc:FoundationDocumentType">
                <xs:annotation>
                    <xs:documentation>Реквизиты документа</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:group ref="tns:DocumentAttachmentsGroup"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
