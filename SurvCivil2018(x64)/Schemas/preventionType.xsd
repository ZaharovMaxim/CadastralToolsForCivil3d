<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           targetNamespace="http://rosleshoz.gov.ru/xmlns/preventionType/5.0"
           xmlns:tns="http://rosleshoz.gov.ru/xmlns/preventionType/5.0"
           xmlns:st="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.0"
           xmlns:comR="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1"
           xmlns:purF="http://rosleshoz.gov.ru/fgis-lk/common/enums/purposeForests/types/2.1">

    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.0" schemaLocation="simpleTypes.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1" schemaLocation="commonReport.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/purposeForests/types/2.1" schemaLocation="dPurposeForestsKindTypes.xsd"/>

    <xs:complexType name="preventionType">
        <xs:sequence>
            <xs:element name="resources" type="tns:resourcesType">
                <xs:annotation>
                    <xs:documentation>Всего</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="specialPurposeInfo">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:specialPurposeRow" minOccurs="1" maxOccurs="3" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="specialPurposeRow">
        <xs:annotation>
            <xs:documentation>Строка целевого назначения</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="resources" type="tns:resourcesType">
                <xs:annotation>
                    <xs:documentation>Всего</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="specialPurpose" type="purF:PurposeForestsKindEType">
                <xs:annotation>
                    <xs:documentation>Целевое назначение лесов</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="locationInfo">
                <xs:annotation>
                    <xs:documentation>Категория защитных лесов (только для защитных лесов)</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:locationRow" minOccurs="0" maxOccurs="unbounded" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="locationRow">
        <xs:sequence>
            <xs:element name="location" type="comR:Location2Type">
                <xs:annotation>
                    <xs:documentation>Место расположения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="resources" type="tns:resourcesType" />
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="resourcesType">
        <xs:sequence>
            <xs:element name="treatmentTtrees" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Лечение деревьев (всего), шт.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="treatmentTtreesAnnual" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Лечение деревьев (ежегодно), шт.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="pesticideApplication" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Применение пестицидов для предотвращения появления очагов вредных организмов (всего), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="pesticideApplicationAnnual" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Применение пестицидов для предотвращения появления очагов вредных организмов (ежегодно), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="fertilizerUse" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Использование удобрений (всего), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="fertilizerUseAnnual" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Использование удобрений (ежегодно), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="improvingConditions" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Улучшение условий (всего), шт</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="improvingConditionsAnnual" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Улучшение условий (ежегодно), шт</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="habitatProtection" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Охрана местообитаний (всего), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="habitatProtectionAnnual" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Охрана местообитаний (ежегодно), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sowing" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Посев травянистых нектароносных растений (всего), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sowingAnnual" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Посев травянистых нектароносных растений (ежегодно), га</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="usePheromones" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Использование феромонов (всего), шт.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="usePheromonesAnnual" type="xs:float">
                <xs:annotation>
                    <xs:documentation>Использование феромонов (ежегодно), шт.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
