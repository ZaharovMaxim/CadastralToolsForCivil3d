<UserControl x:Class="CadastrData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SurvCivil2018_x64_"
             mc:Ignorable="d" Width="343.062" Height="487.775" Foreground="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" HorizontalAlignment="Left" VerticalAlignment="Top" >
    <Grid x:Name="Grid_Object" Margin="0,-19,-20,10" RenderTransformOrigin="0.609,0.503" MinWidth="400" MinHeight="400" Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}">
        <DataGrid x:Name="DataGrid_Rosreestr" Margin="15,112,67,47" Background="{x:Null}" CanUserResizeRows="True">
            <DataGridTextColumn Header="Message" Binding="{Binding Path=Message}"  Width="Auto">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </DataGridTextColumn.ElementStyle>
                <DataGridTextColumn.EditingElementStyle>
                    <Style TargetType="TextBox">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="AcceptsReturn" Value="true" />
                    </Style>
                </DataGridTextColumn.EditingElementStyle>
            </DataGridTextColumn>
        </DataGrid>
        <TextBox x:Name="TextBox_Number" HorizontalAlignment="Left" Height="23" Margin="15,84,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="110"/>
        <ComboBox x:Name="Combo_Type_Object" HorizontalAlignment="Left" Height="23" Margin="135,84,0,0" VerticalAlignment="Top" Width="198"/>
        <Label Content="Кад. номер" HorizontalAlignment="Left" Height="25" Margin="15,59,0,0" VerticalAlignment="Top" Width="120"/>
        <Label Content="Тип объекта" HorizontalAlignment="Left" Height="25" Margin="177,59,0,0" VerticalAlignment="Top" Width="104"/>
        <Button x:Name="Button_Zapros" Content="Запрос" HorizontalAlignment="Left" Height="30" Margin="230,24,0,0" VerticalAlignment="Top" Width="103" Click="Button_Click_1" RenderTransformOrigin="0.521,-1.265" Background="#66640000"/>
        <ComboBox x:Name="Combo_Type_d" HorizontalAlignment="Left" Height="30" Margin="15,24,0,0" VerticalAlignment="Top" Width="197"/>
    </Grid>
</UserControl>
