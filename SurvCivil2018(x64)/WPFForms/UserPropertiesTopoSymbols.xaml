<UserControl x:Class="UserPropertiesTopoSymbols"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="500" Width="300">
    <Grid Margin="0,0,-25,-239" Background="#FF3B4453" MinWidth="250" MinHeight="250">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="162*"/>
            <ColumnDefinition Width="163*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="404*"/>
            <RowDefinition Height="335*"/>
        </Grid.RowDefinitions>
        <CheckBox x:Name="CheboxStyle" Content="Перезаписать стиль объекта" HorizontalAlignment="Left" Height="20" Margin="10,77,0,0" VerticalAlignment="Top" Width="182" Grid.ColumnSpan="2" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Label x:Name="UserProperties" Content="Настройки пользователя" HorizontalAlignment="Left" Margin="50,10,0,0" Width="198" Grid.ColumnSpan="2" Background="{x:Null}" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" FontSize="16" Height="35" VerticalAlignment="Top"/>
        <CheckBox x:Name="CheboxDataPs" Content="Не изменять объектные данные" HorizontalAlignment="Left" Height="20" Margin="10,102,0,0" VerticalAlignment="Top" Width="202" Grid.ColumnSpan="2" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" IsChecked="True"/>
        <CheckBox x:Name="CheboxFeatureLine" Content="Преобразовать в Характерную линию" HorizontalAlignment="Left" Height="20" Margin="10,127,0,0" VerticalAlignment="Top" Width="238" Grid.ColumnSpan="2" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <CheckBox x:Name="CheboxAddSurface" Content="Добавить в поверхность как структурную линию" HorizontalAlignment="Left" Height="20" Margin="10,152,0,0" VerticalAlignment="Top" Width="295" Grid.ColumnSpan="2" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <CheckBox x:Name="CheboxReplaseObject" Content="Заменить объект" HorizontalAlignment="Left" Height="20" Margin="10,177,0,0" VerticalAlignment="Top" Width="182" Grid.ColumnSpan="2" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" IsChecked="True"/>
        <ComboBox x:Name="ComboAlign" Grid.ColumnSpan="2" HorizontalAlignment="Right" Height="25" Margin="0,231,72,0" VerticalAlignment="Top" Width="238"/>
        <ComboBox x:Name="ComboSurface" Grid.ColumnSpan="2" Height="25" Margin="0,289,72,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="238"/>
        <Label Content="Активная трасса" HorizontalAlignment="Left" Height="28" Margin="99,203,0,0" VerticalAlignment="Top" Width="98" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" Grid.ColumnSpan="2"/>
        <Label Content="Активная поверхность (проектная)" HorizontalAlignment="Left" Height="28" Margin="70,261,0,0" VerticalAlignment="Top" Width="206" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" Grid.ColumnSpan="2"/>
        <Button x:Name="ButtonUpdateAlign" Content="Обновить" Grid.Column="1" Height="25" Margin="0,231,5,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="62"/>
        <Button x:Name="ButtonUpdateSurface" Content="Обновить" Grid.Column="1" Height="25" Margin="0,289,5,0" VerticalAlignment="Top" RenderTransformOrigin="0.54,2.507" HorizontalAlignment="Right" Width="62"/>

    </Grid>
</UserControl>
